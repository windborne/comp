/// Zulip bot an organization uses to mirror its email notifications as direct
/// messages. Recipients are matched by email address, so members get the DM
/// only when their Comp AI and Zulip accounts share an address.
model ZulipIntegration {
  id             String       @id @default(dbgenerated("generate_prefixed_cuid('zul'::text)"))
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Zulip server origin, e.g. https://chat.example.com
  siteUrl  String
  /// Email of the generic bot that sends the messages
  botEmail String
  /// Bot API key, AES-256-GCM encrypted with ENCRYPTION_KEY (JSON of EncryptedData)
  botApiKey String  @db.Text
  enabled   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("zulip_integration")
}
